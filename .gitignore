# Raw datasets and downloaded archives stay outside Git history.
/dataset/*
!/dataset/README.md
/downloads/
/external/*
!/external/hulk_manifest.example.json
!/external/lan_manifest.example.json
*.zip
*.7z
*.rar
*.tar
*.gz

# Generated data, private experiment outputs and fitted models.
/data/
/data_cache/
/outputs/
**/private_DO_NOT_UPLOAD/
**/adapter_diagnostics_private.json
**/simulation_ledgers/
**/privacy_budget_ledgers*/
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.parquet
*.pcap
*.pcapng
*.pkl
*.pickle
*.joblib
*.log

# Python environments, packaging and local development files.
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
/wheelhouse/
/installed_wheel_check.json
/.venv/
/venv/
/.idea/
/.run/*
!/.run/FedCAID.run.xml
/.vscode/
/.pytest_cache/
/examples/
/tmp/
/run_main.local.cmd
.env
.env.*
.DS_Store
Thumbs.db
